rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validUpload(maxBytes) {
      return request.resource.size < maxBytes &&
        request.resource.contentType.matches('(image/.*|application/pdf)');
    }

    match /users/{userId}/profile/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId && validUpload(5 * 1024 * 1024);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/documents/{fileName} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update: if signedIn() && request.auth.uid == userId && validUpload(10 * 1024 * 1024);
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
